# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cortex:cortex_dev@localhost:5432/cortex
POSTGRES_PASSWORD=cortex_dev
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3100
API_KEYS=dev-key-1

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Optional: Anthropic (enables Claude chat engine) ─────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxx

# ── Scan / semantic analysis tuning ──────────────────────────────────────────
# Concurrent scan jobs picked off the BullMQ queue (default: 3)
# CORTEX_SCAN_CONCURRENCY=3
#
# Number of attempts before a scan is marked "failed" (default: 2).
# Auto-retries on worker death/reload; doesn't help against deterministic bugs.
# CORTEX_SCAN_ATTEMPTS=2
#
# Set to "true" to use a fast preset (parallelism=12, min_size=6, max=30 communities).
# CORTEX_SEMANTIC_FAST=true
#
# Or override individual semantic-analysis tunables (defaults shown):
# CORTEX_SEMANTIC_PARALLELISM=8        # parallel Claude CLI calls
# CORTEX_SEMANTIC_MIN_SIZE=4           # skip communities smaller than this
# CORTEX_SEMANTIC_MAX_COMMUNITIES=50   # cap on # of communities analyzed (0 = unlimited)
#
# Set CORTEX_SEMANTIC_ANALYSIS=false to skip the LLM coherence check entirely.
